# Copia este archivo como .env y ajusta los valores. El .env real no se versiona.

APP_NAME="Auditores de Talleres"
# production | local
APP_ENV=production
APP_DEBUG=false
# URL pública sin diagonal final; si la app vive en una subcarpeta, inclúyela.
APP_URL=https://auditorias.anahuac.mx
APP_TIMEZONE=America/Mexico_City

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=auditores_talleres
DB_USER=auditores
DB_PASS=
# Zona horaria de la sesión MySQL (México centro, sin horario de verano).
DB_TIMEZONE=-06:00

# En producción siempre true (requiere HTTPS). En desarrollo local sin HTTPS: false.
SESSION_SECURE=true
SESSION_IDLE_MINUTES=30

# Dominios de correo permitidos para ingresar y registrarse, separados por comas.
AUTH_ALLOWED_DOMAINS=anahuac.mx
# Intentos fallidos permitidos (por correo o por IP) dentro de la ventana antes del bloqueo.
AUTH_MAX_FAILS=5
AUTH_LOCK_MINUTES=15
