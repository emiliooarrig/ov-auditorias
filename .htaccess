# Defensa en profundidad: la raíz web debe ser public/. Si por error el servidor apunta a la raíz
# del proyecto, se niega todo acceso para no exponer .env, vendor/, storage/ ni el código.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
